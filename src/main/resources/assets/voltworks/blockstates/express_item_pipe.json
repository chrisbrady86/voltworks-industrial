{ "multipart": [
  { "apply": { "model": "voltworks:block/express_item_pipe_core" } },
  { "when": { "north": "connected|extract" }, "apply": { "model": "voltworks:block/express_item_pipe_side" } },
  { "when": { "north": "extract" }, "apply": { "model": "voltworks:block/express_item_pipe_extract" } },
  { "when": { "north": "disabled" }, "apply": { "model": "voltworks:block/express_item_pipe_cap" } },
  { "when": { "east": "connected|extract" }, "apply": { "model": "voltworks:block/express_item_pipe_side", "y": 90 } },
  { "when": { "east": "extract" }, "apply": { "model": "voltworks:block/express_item_pipe_extract", "y": 90 } },
  { "when": { "east": "disabled" }, "apply": { "model": "voltworks:block/express_item_pipe_cap", "y": 90 } },
  { "when": { "south": "connected|extract" }, "apply": { "model": "voltworks:block/express_item_pipe_side", "y": 180 } },
  { "when": { "south": "extract" }, "apply": { "model": "voltworks:block/express_item_pipe_extract", "y": 180 } },
  { "when": { "south": "disabled" }, "apply": { "model": "voltworks:block/express_item_pipe_cap", "y": 180 } },
  { "when": { "west": "connected|extract" }, "apply": { "model": "voltworks:block/express_item_pipe_side", "y": 270 } },
  { "when": { "west": "extract" }, "apply": { "model": "voltworks:block/express_item_pipe_extract", "y": 270 } },
  { "when": { "west": "disabled" }, "apply": { "model": "voltworks:block/express_item_pipe_cap", "y": 270 } },
  { "when": { "up": "connected|extract" }, "apply": { "model": "voltworks:block/express_item_pipe_side", "x": 270 } },
  { "when": { "up": "extract" }, "apply": { "model": "voltworks:block/express_item_pipe_extract", "x": 270 } },
  { "when": { "up": "disabled" }, "apply": { "model": "voltworks:block/express_item_pipe_cap", "x": 270 } },
  { "when": { "down": "connected|extract" }, "apply": { "model": "voltworks:block/express_item_pipe_side", "x": 90 } },
  { "when": { "down": "extract" }, "apply": { "model": "voltworks:block/express_item_pipe_extract", "x": 90 } },
  { "when": { "down": "disabled" }, "apply": { "model": "voltworks:block/express_item_pipe_cap", "x": 90 } }
] }
