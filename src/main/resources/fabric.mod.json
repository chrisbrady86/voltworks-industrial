	"license": "MIT",
	"icon": "assets/voltworks/icon.png",
	"contact": {
		"homepage": "https://github.com/chrisbrady86/voltworks-industrial",
		"sources": "https://github.com/chrisbrady86/voltworks-industrial",
		"issues": "https://github.com/chrisbrady86/voltworks-industrial/issues"
	},
